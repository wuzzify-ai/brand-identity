NODE_ENV=development

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

WORKER_CONCURRENCY=2

DATABASE_URL=postgres://brand_identity:brand_identity_dev@localhost:15432/brand_identity_v3
REDIS_URL=redis://localhost:56379/0

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-local-development-key
OPENROUTER_BRIEF_MODEL=anthropic/claude-sonnet-4
OPENROUTER_STRATEGY_MODEL=openai/gpt-4.1
OPENROUTER_VISUAL_MODEL=anthropic/claude-sonnet-4
OPENROUTER_ASSET_MODEL=openai/gpt-image-1
AI_WORKSPACE_MONTHLY_BUDGET_MICRO_USD=100000000
AI_GENERATION_PRECHARGE_MICRO_USD=1000000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brand-identity-assets
S3_ACCESS_KEY_ID=brand_identity_minio
S3_SECRET_ACCESS_KEY=brand_identity_minio_dev_secret
PUBLIC_ASSET_CDN_URL=http://localhost:9000/brand-identity-assets
AUTHENTICATED_UPLOAD_MAX_BYTES=26214400
ASSET_UPLOAD_GRANT_TTL_SECONDS=900
ASSET_DOWNLOAD_GRANT_TTL_SECONDS=300
ANONYMOUS_UPLOAD_MAX_BYTES=10485760
ANONYMOUS_UPLOAD_GRANT_TTL_SECONDS=900

JWT_ACCESS_SECRET=replace-with-32-character-minimum-local-secret
JWT_REFRESH_SECRET=replace-with-another-32-character-minimum-secret
JWT_ISSUER=brand-identity-api
JWT_AUDIENCE=brand-identity-web
JWT_ACCESS_PRIVATE_KEY=replace-with-rs256-private-key-pem-using-escaped-newlines
JWT_ACCESS_PUBLIC_KEY=replace-with-rs256-public-key-pem-using-escaped-newlines
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

EMAIL_FROM=brand-identity@localhost
SMTP_URL=smtp://localhost:1025
TOKEN_HASH_PEPPER=replace-with-32-character-minimum-token-pepper
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
