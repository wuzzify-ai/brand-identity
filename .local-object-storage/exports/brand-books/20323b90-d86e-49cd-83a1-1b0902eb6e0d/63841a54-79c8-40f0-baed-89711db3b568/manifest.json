d-4a11-b2e5-4826a666dc88","name":"Slate Rule","origin":"USER","rgb":{"b":235,"g":231,"r":229},"sort_order":3,"token_name":"color-surface-mid","updated_at":"2026-07-31T00:04:57.045012+00:00","usage":"Borders, dividers, table lines, secondary surfaces","visual_direction_id":"133bc927-88c7-470b-99c4-20c262e21e37"},{"contrast_on_black":2.04,"contrast_on_white":10.31,"created_at":"2026-07-31T00:04:57.045012+00:00","hex":"#374151","hsl":{"h":217,"l":26.67,"s":19.12},"id":"7905d353-a772-4842-a250-0b225de2a3e2","name":"Cool Charcoal","origin":"USER","rgb":{"b":81,"g":65,"r":55},"sort_order":4,"token_name":"color-text-body","updated_at":"2026-07-31T00:04:57.045012+00:00","usage":"Body copy, labels, secondary content","visual_direction_id":"133bc927-88c7-470b-99c4-20c262e21e37"},{"contrast_on_black":8.28,"contrast_on_white":2.54,"created_at":"2026-07-31T00:04:57.045012+00:00","hex":"#10B981","hsl":{"h":160,"l":39.41,"s":84.08},"id":"779303c7-0e12-4984-82b5-27e34615a9c4","name":"Confirm Green","origin":"USER","rgb":{"b":129,"g":185,"r":16},"sort_order":5,"token_name":"color-status-success","updated_at":"2026-07-31T00:04:57.045012+00:00","usage":"Success states, completed workflow indicators, uptime signals","visual_direction_id":"133bc927-88c7-470b-99c4-20c262e21e37"}],"visualDirection":{"archived_at":null,"created_at":"2026-07-31T00:04:49.885605+00:00","id":"133bc927-88c7-470b-99c4-20c262e21e37","identity_version_id":"20323b90-d86e-49cd-83a1-1b0902eb6e0d","imagery":["Clean, abstract visualisations of flow: connected nodes, process paths, pipeline diagrams — rendered in brand palette","UI screenshots at full resolution showing clear, organised dashboards","Flat-lay product metaphors: clean desk, single device, minimal clutter — high contrast lighting","Black and white photography with a single teal accent element composited in","Avoid warm-toned lifestyle imagery — this palette reads cold next to earth tones","Outline icon style: 1.5px stroke, sharp corners with 2px radius only","24px and 16px grid variants required for UI and marketing respectively","Flow-specific metaphors: branching arrows, toggle switches, looping arrows, plug/socket for integrations","Teal used as the single accent color for interactive or highlighted icons","Icon grid must be mathematically consistent — no optical sizing adjustments","Hard rectangles with 4–6px border radius maximum — precision over friendliness","Thin 1px rules used as section dividers rather than padding alone","Pill shapes reserved exclusively for status badges and tags","No organic or blob shapes — discipline of form is part of the brand message","Thin-bordered cards with a 1px Slate Rule border rather than drop shadows","Fine 1px grid lines at 3% opacity as hero background texture — references the idea of structured workflow","No paper or organic textures — counter to the precision positioning","Subtle linear gradient on CTA buttons: teal to a 15% lighter teal — adds depth without breaking flat-design discipline","Dark sections use a near-invisible 2% noise overlay to prevent pure black flatness"],"is_selected":true,"layout_notes":["Strong grid structure: 12-column desktop, 4-column mobile, 8px base unit","Section backgrounds alternate between Signal White and a 4% tint of Graphite Core","Full-bleed dark hero section with teal accent headline word or underline","Data and feature sections use card grids with consistent column alignment","Process step visualisations shown as horizontal numbered flows on desktop, vertical on mobile","Base unit: 8px strict grid","Section vertical padding: 80px desktop, 48px mobile","Card internal padding: 24px all sides","Headline to subheadline gap: 12px","Component group spacing: 32px; between sections: 96px desktop","Transitions: 150–250ms ease-in-out — snappy, not sluggish","Counter animations on key metrics when they enter viewport — reinforces data and reliability","Workflow diagram animations: nodes connect sequentially left-to-right, 300ms per step","Hover on cards: border color transitions from Slate Rule to Electric Teal at 200ms","No bounce or spring physics — linear or ease curves only; precision implies control","WCAG AA compliance mandatory; WCAG AAA target for all body text","Electric Teal (#06B6D4) on white (#F9FAFB) — verify contrast ratio; use darker teal variant (#0891B2) if failing 4.5:1","Focus ring: 2px solid Electric Teal, 2px offset, visible on both light and dark backgrounds","All data visualisations must include text equivalents or accessible data tables","Icon-only UI elements require aria-label; status colors always paired with text labels","Warm amber, orange, or brown tones — incompatible with the precision palette","Decorative gradients across backgrounds — use only on interactive elements","Heavy drop shadows — use borders instead to maintain disciplined geometry","Rounded corners above 6px — softens the precision signal","Any imagery showing overwhelmed or stressed operators — counter to empowerment values","Overcrowded layouts — white space is structural in this direction, not decorative"],"lock_version":3,"mood_keywords":["precise","reliable","clean","capable","structured","direct"],"name":"Precision Flow","origin":"USER","rationale":"A crisp, high-contrast system identity that communicates capability and reliability through disciplined geometry, clear typographic hierarchy, and a restrained color palette. Confidence through order — this platform runs like clockwork.\n\nSome small business owners — particularly those who've been burned by unreliable tools — respond to visual signals of precision and dependability over warmth. This direction uses high contrast, tight grids, and deliberate use of a single electric accent to communicate that the product is serious, dependable, and genuinely powerful without feeling out of reach.","selected_at":"2026-07-31T00:05:13.853843+00:00","status":"ACTIVE","updated_at":"2026-07-31T00:05:13.853843+00:00"},"visualFonts":[{"created_at":"2026-07-31T00:04:57.